# GNews.io API key — real disaster-news feed (create at https://gnews.io).
# Free plan: articles publish with a ~12-hour delay and a daily request quota
# applies — both are disclosed honestly in the app UI.
GNEWS_API_KEY=YOUR_GNEWS_API_KEY_HERE

# NASA FIRMS MAP_KEY — free key for the official active-fire data API.
# Request it at https://firms.modaps.eosdis.nasa.gov/api/area/ ("Get MAP Key").
# Without it, the app still works and honestly labels the fire layer
# "unavailable — no key configured".
FIRMS_MAP_KEY=YOUR_FIRMS_MAP_KEY_HERE

# Supabase Authentication Backend
SUPABASE_URL=https://wjqbnwwqqsnlgbkrlkmv.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY_HERE

