<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) launch theme - THE FIX FOR THE GREEN STARTUP POPUP.

  WHY THE GREEN POPUP HAPPENED:
  From API 31 the platform SplashScreen API draws the startup screen itself and
  ignores the old windowBackground drawable. With neither
  windowSplashScreenBackground nor windowSplashScreenAnimatedIcon specified,
  the system fell back to:
    - background: the colour derived from windowBackground, which was the brand
      green #008459; and
    - icon: the application launcher icon (@mipmap/ic_launcher, i.e. the
      adaptive icon) scaled into the splash icon circle.
  That combination is exactly the reported symptom: a green popup showing an
  icon that is not the app intended startup mark.

  WHAT THIS THEME DOES:
    - windowSplashScreenBackground pins the neutral near-white that the logo
      artwork is drawn on, instead of green.
    - windowSplashScreenAnimatedIcon pins the REAL Vippatti Sarana logo, so the
      launcher icon is no longer substituted for it.
    - windowBackground is the flat colour (not the layer-list used below API 31)
      so the logo is not drawn twice: once by the splash and again by the window
      behind the first Compose frame.

  No windowSplashScreenAnimationDuration is set and no delay is introduced: the
  splash is dismissed by the platform as soon as the first frame is ready.
-->
<resources>

    <style name="Theme.MyApplication" parent="android:Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
    </style>

</resources>