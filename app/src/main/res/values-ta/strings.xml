    <string name="onboarding_welcome_body">விபத்தி சரணா அத்தியாவசிய பேரிடர் தகவல், பாதுகாப்பு வழிகாட்டுதல் மற்றும் அவசர கருவிகளை ஒரே இடத்தில் தருகிறது.</string>
    <string name="onboarding_map_title">உங்களைச் சுற்றியுள்ள அபாயத்தைப் பாருங்கள்.</string>
    <string name="onboarding_map_body">ரேடார் வரைபடத்தில் உங்கள் இருப்பிடத்தைச் சுற்றியுள்ள பேரிடர் எச்சரிக்கைகள், அபாயங்கள், பாதுகாப்பான பகுதிகள் மற்றும் முக்கிய நிலைமைகளை அறியவும்.</string>
    <string name="onboarding_map_illustration_cd">அபாய மற்றும் பாதுகாப்பான பகுதி குறிகளுடன் ரேடார் வரைபட விளக்கப்படம்</string>
    <string name="onboarding_news_title">தகவலுடன் இருங்கள். தயாராக இருங்கள்.</string>
    <string name="onboarding_news_body">பேரிடர் தொடர்பான புதுப்பிப்புகள் மற்றும் தொடர்புடைய செய்திகளைப் பெற்று, என்ன நடக்கிறது என்பதை அறிந்து அதிகாரப்பூர்வ வழிகாட்டுதலைப் பின்பற்றுங்கள்.</string>
    <string name="onboarding_news_illustration_cd">பேரிடர் செய்திகளைக் காட்டும் தொலைபேசி விளக்கப்படம்</string>
