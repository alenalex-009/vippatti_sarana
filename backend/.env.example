# ---- Vippatti Sarana backend configuration ----------------------------------
# Copy this file to backend/.env and fill in real values. NEVER commit .env.

# PostgreSQL connection string for SQLAlchemy / Alembic.
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/vippatti_sarana

# Secret used to sign JWT access tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE-ME-generate-a-real-secret

# Token lifetimes (minutes / days).
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS origins allowed to call this API from a browser (the Android app is not
# browser-based, so this list is usually empty in development).
BACKEND_CORS_ORIGINS=[]
